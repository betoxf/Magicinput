<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package. scripts/package-msix.sh fills in the {{...}} values; the identity
     comes from Partner Center (Product management > Product identity). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop desktop2 rescap">
  <Identity Name="{{NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64"/>
  <Properties>
    <DisplayName>MagicInput</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0"/>
  </Dependencies>
  <Resources>
    <Resource Language="en-us"/>
  </Resources>
  <Applications>
    <Application Id="MagicInput" Executable="magicinput-app.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="MagicInput" Description="One keyboard and mouse for your Mac and your PC."
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
      </uap:VisualElements>
      <Extensions>
        <!-- The background service at sign-in (magicinputw.exe without arguments runs it). -->
        <desktop:Extension Category="windows.startupTask" Executable="magicinputw.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="MagicInputService" Enabled="true" DisplayName="MagicInput"/>
        </desktop:Extension>
        <!-- `magicinput status`, `magicinput pair ...` in a terminal. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="magicinput.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="magicinput.exe"/>
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Extensions>
    <!-- The connection from the other computer, and discovery (mDNS), on private networks. -->
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="magicinputw.exe">
        <desktop2:Rule Direction="in" IPProtocol="TCP" LocalPortMin="24842" LocalPortMax="24842" Profile="domainAndPrivate"/>
        <desktop2:Rule Direction="in" IPProtocol="UDP" LocalPortMin="5353" LocalPortMax="5353" Profile="domainAndPrivate"/>
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>
  <Capabilities>
    <Capability Name="internetClientServer"/>
    <Capability Name="privateNetworkClientServer"/>
    <rescap:Capability Name="runFullTrust"/>
  </Capabilities>
</Package>
